.DS_Store
.claude/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Secrets
.env
.env.*
!.env.example

# Large binaries. Weights are tracked by neither half of the split: the ones
# backend needs to run ship with the deployment, not through git.
backend/models/
data/
dev/models_fp16/
dev/uae-main/
dev/pdf/node_modules/
demo/**/*.mp4

# Dev scratch: bench logs, frame dumps, regression records, run artefacts.
dev/outputs/
dev/bench/*.jpg
dev/bench/*.jpeg
dev/bench/*.png
dev/bench/*.npy

# Runtime data and evidence. Zone configs are NOT here any more -- they are
# input the pipeline reads at runtime, so they live in backend/config/zones/
# and are tracked.
backend/data/alerts/
backend/data/alerts_runtime_test/
backend/data/alerts_targeted/
backend/data/face_artifacts/
backend/data/*.sqlite
backend/data/*.sqlite-*
backend/data/*.lock
backend/data/*.json

# mediamtx tu sinh cert cho MoQ/QUIC khi chay rtsp_sim
auto.crt
auto.key

# Local scratch at the repo root and a one-off document not kept in git.
/outputs/
docs/remote_support_setup.pdf
