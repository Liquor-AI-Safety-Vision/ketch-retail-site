.DS_Store
.claude/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Secrets
.env
.env.*
!.env.example

# Large binaries. Weights are tracked by neither half of the split: the ones
# ai/ needs to run ship with the deployment, not through git.
ai/models/
data/
ai/dev/models_fp16/
ai/dev/uae-main/
ai/dev/pdf/node_modules/
ai/demo/**/*.mp4

# Dev scratch: bench logs, frame dumps, regression records, run artefacts.
ai/dev/outputs/
ai/dev/bench/*.jpg
ai/dev/bench/*.jpeg
ai/dev/bench/*.png
ai/dev/bench/*.npy

# Runtime data and evidence. Zone configs are NOT here any more -- they are
# input the pipeline reads at runtime, so they live in ai/config/zones/
# and are tracked.
ai/data/alerts/
ai/data/alerts_runtime_test/
ai/data/alerts_targeted/
ai/data/face_artifacts/
ai/data/*.sqlite
ai/data/*.sqlite-*
ai/data/*.lock
ai/data/*.json

# mediamtx tu sinh cert cho MoQ/QUIC khi chay rtsp_sim
auto.crt
auto.key

# Local scratch at the repo root and a one-off document not kept in git.
/outputs/
ai/docs/remote_support_setup.pdf

# Private environment ZIP (all service credentials). Never commit.
liquor-env.txt
*.env.zip
