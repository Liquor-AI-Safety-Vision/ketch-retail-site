{
  "name": "ketch-retail-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/write-security-headers.mjs && tsc -b && vite build",
    "test:security": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "node tests/browser-security.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "api:dev": "npm --prefix apps/api-go run dev",
    "api:build": "npm --prefix apps/api-go run build",
    "api:check": "npm --prefix apps/api-go run check",
    "api:migrate": "npm --prefix apps/api-go run db:migrate",
    "api:seed": "npm --prefix apps/api-go run db:seed",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name=ketch-enterprise --branch=main"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/outfit": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.101.4",
    "gsap": "^3.15.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
