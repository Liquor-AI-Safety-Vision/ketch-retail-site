# Copy to deploy/liquor.env (ignored by git) and fill in. Read by every
# service started from deploy/; the process environment overrides it.
# Secrets for the API and the AI stay in backend/.env and ai/.env.

# test: MediaMTX replays each camera's footage from the store manifest, looped.
# production: MediaMTX relays the real cameras listed in cameras.production.json.
MODE=test

# The store this server watches (cameras, pipelines, zones).
# Every store this server runs, separated by spaces (camera_ids unique across
# them). Which owner sees which store: deploy/liquorctl owner <email> <name> <store,...>
STORE_MANIFEST=ai/config/stores/store_test_01.json

# Web front (Caddy). WEB_LISTEN is host:port for plain HTTP on this machine;
# set SITE_ADDRESS to a domain (e.g. dashboard.example.com) for automatic HTTPS.
WEB_LISTEN=127.0.0.1:18000
SITE_ADDRESS=
# The address browsers use; also the API's CORS origin and link base.
PUBLIC_URL=http://localhost:18000

# MediaMTX read account (the AI's RTSP reads and Caddy's HLS reads). Loopback only.
MEDIAMTX_READ_USER=ai
MEDIAMTX_READ_PASS=change-me-random

# Python environment with ai/requirements.txt + onnxruntime(-gpu).
PYTHON=/venv/liquor/bin/python

# AI tiers (ai/src/app/run_split_pipeline.py); --cameras is taken from the manifest.
# Several GPUs are used automatically (--gpus auto): inference process k runs on
# GPU k % GPUs, so keep --inferers at least the number of GPUs.
AI_ARGS="--decoders 4 --inferers 2 --infer-threads 3 --business 2"

# Where test mode caches its normalised H.264 copies (1-2 GB).
PLAYLIST_CACHE=
