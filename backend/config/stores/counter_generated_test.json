{
  "company_id": "liquor_store_demo",
  "store_id": "counter_generated_test",
  "display_name": "Counter Generated Test Clips",
  "timezone": "America/New_York",
  "mode": "local_dev",
  "runtime": {
    "default_target_fps": 5,
    "target_duration_s": 180,
    "drop_if_lagging": true,
    "simulation_clock": {
      "enabled": true,
      "started_at_local": "2026-08-23T20:30:00",
      "playback_speed": 1.0
    }
  },
  "policies": {
