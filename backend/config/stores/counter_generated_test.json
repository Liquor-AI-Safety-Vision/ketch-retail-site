          "target_duration_s": 8
        }
      },
      "runtime": {
        "target_fps": 5,
        "device": "cpu"
      },
      "perception": {
        "person_detector": {
          "device": "cpu",
          "conf_thres": 0.5,
          "nms_thres": 0.7
        },
        "person_tracker": {
          "device": "cpu",
