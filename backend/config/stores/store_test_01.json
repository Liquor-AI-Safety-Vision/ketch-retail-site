{
  "company_id": "liquor_store_demo",
  "store_id": "store_test_01",
  "display_name": "Store test 01",
  "timezone": "Asia/Ho_Chi_Minh",
  "runtime": {
    "default_target_fps": 5
  },
  "cameras": [
    {
      "camera_id": "st01_counter",
      "display_name": "Counter",
      "camera_type": "counter",
      "stream": {
        "input_mode": "video_file",
        "uri": "${DATA_ROOT}/videos/cctv_counter/cash_till_open_2.mp4",
        "simulation": { "strategy": "forever" },
        "playlist": [
          { "uri": "${DATA_ROOT}/videos/cctv_counter/cash_till_open_2.mp4", "repeat": 100 },
          { "uri": "${DATA_ROOT}/videos/counter-generated/Right/cvlp_h3_00013_.mp4", "repeat": 1 }
        ]
      },
      "runtime": { "target_fps": 5 },
      "perception": {
        "person_detector": { "conf_thres": 0.5 }
      },
      "pipelines": [
        {
          "pipeline_id": "counter_cash_theft_v1",
          "enabled": true,
          "params": {
            "suppress_if_customer_recent": true,
            "customer_recent_window_s": 3.0,
            "zones_path": "${BACKEND_ROOT}/config/zones/top_side_view_zones.json",
            "till_conf": 0.7,
            "till_confirm_frames": 5,
            "till_fps": 3,
            "alert_clip": { "pre_s": 15, "post_s": 15 }
          }
        }
      ]
    },
    {
      "camera_id": "st01_storage",
      "display_name": "Storage",
      "camera_type": "storage",
      "stream": {
        "input_mode": "video_file",
        "uri": "${DATA_ROOT}/videos/cctv_storage/storage_2.mp4",
        "simulation": { "strategy": "forever" }
      },
      "runtime": { "target_fps": 5 },
      "perception": {
        "person_detector": { "conf_thres": 0.5 },
        "face_identity": { "enabled": true, "match_threshold": 0.25, "match_margin": 0.1 }
      },
      "pipelines": [
        {
          "pipeline_id": "storage_intrusion_v1",
          "enabled": true,
          "params": {
            "entry_confirm_seconds": 1.0,
            "zone_config_path": "${BACKEND_ROOT}/config/zones/storage_zones.json",
            "zone_asset_key": "storage_2",
            "face_capture_window": { "end_after_inside_s": 1.0 },
            "alert_clip": { "pre_s": 15, "post_s": 15 },
            "access_schedule": {
              "allowed_windows": [
                { "days": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"], "start": "08:00", "end": "09:00" },
                { "days": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"], "start": "21:00", "end": "22:00" }
              ]
            }
          }
        }
      ]
    },
    {
      "camera_id": "st01_cold_storage",
      "display_name": "Cold Storage",
      "camera_type": "cold_storage",
      "stream": {
        "input_mode": "video_file",
        "uri": "${DATA_ROOT}/videos/cctv_storage/storage_1.mp4",
        "simulation": { "strategy": "forever" }
      },
      "runtime": { "target_fps": 5 },
      "perception": {
        "person_detector": { "conf_thres": 0.5 },
        "face_identity": { "enabled": true, "match_threshold": 0.25, "match_margin": 0.1 }
      },
      "pipelines": [
        {
          "pipeline_id": "cold_storage_intrusion_v1",
          "enabled": true,
          "params": {
            "entry_confirm_seconds": 1.0,
            "zone_config_path": "${BACKEND_ROOT}/config/zones/storage_zones.json",
            "zone_asset_key": "storage_1",
            "face_capture_window": { "end_after_inside_s": 1.0 },
            "alert_clip": { "pre_s": 15, "post_s": 15 },
            "access_schedule": {
              "allowed_windows": [
                { "days": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"], "start": "08:00", "end": "09:00" },
                { "days": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"], "start": "21:00", "end": "22:00" }
              ]
            }
          }
        }
      ]
    },
    {
      "camera_id": "st01_entrance",
      "display_name": "Entrance",
      "camera_type": "entrance",
      "stream": {
        "input_mode": "video_file",
        "uri": "${DATA_ROOT}/videos/entrance/entrance.mp4",
        "simulation": { "strategy": "forever" }
      },
      "runtime": { "target_fps": 5 },
      "perception": {
        "person_detector": { "conf_thres": 0.45 },
        "face_identity": { "enabled": true, "face_conf": 0.4, "match_threshold": 0.6 }
      },
      "pipelines": [
        {
          "pipeline_id": "entrance_face_capture_v1",
          "enabled": true,
          "params": {
            "zone_config_path": "${BACKEND_ROOT}/config/zones/entrance_zone.json",
            "zone_asset_key": "entrance",
            "entry_confirm_seconds": 0.5,
            "min_face_h": 32,
            "face_top_frac": 0.35,
            "face_capture_window": { "end_after_inside_s": 1.0 },
            "alert_clip": { "pre_s": 15, "post_s": 15 }
          }
        }
      ]
    },
    {
      "camera_id": "st01_whole_store",
      "display_name": "Whole Store",
      "camera_type": "whole_store",
      "stream": {
        "input_mode": "video_file",
        "uri": "${DATA_ROOT}/videos/whole_store/whole_store_long.mp4",
        "simulation": { "strategy": "forever" }
      },
      "runtime": { "target_fps": 5 },
      "perception": { "person_detector": { "conf_thres": 0.5 } },
      "pipelines": [{ "pipeline_id": "whole_store_tracking_v1", "enabled": true, "params": {} }]
    },
    {
      "camera_id": "st01_whole_store_corner",
      "display_name": "Whole Store Corner",
      "camera_type": "whole_store",
      "stream": {
        "input_mode": "video_file",
        "uri": "${DATA_ROOT}/videos/whole_store/whole_store_corner.mp4",
        "simulation": { "strategy": "forever" }
      },
      "runtime": { "target_fps": 5 },
      "perception": { "person_detector": { "conf_thres": 0.5 } },
      "pipelines": [{ "pipeline_id": "whole_store_tracking_v1", "enabled": true, "params": {} }]
    },
    {
      "camera_id": "st01_cold_drinks",
      "display_name": "Cold Drinks",
      "camera_type": "cold_drinks",
      "stream": {
        "input_mode": "video_file",
        "uri": "${DATA_ROOT}/videos/whole_store/cold_drinks.mp4",
        "simulation": { "strategy": "forever" }
      },
      "runtime": { "target_fps": 5 },
      "perception": { "person_detector": { "conf_thres": 0.5 } },
      "pipelines": [{ "pipeline_id": "whole_store_tracking_v1", "enabled": true, "params": {} }]
    }
  ]
}
