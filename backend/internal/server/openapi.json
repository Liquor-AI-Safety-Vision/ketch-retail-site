{
  "openapi": "3.0.3",
  "info": {
    "title": "Liquor Store Security API",
    "description": "Dashboard API over the AI service's database. Stores, cameras, alerts and alert media are written by the AI service (ai/); this API reads them, records review decisions, serves media from R2 through expiring links, and sends notifications. Values use the AI schema's vocabulary: lowercase roles, statuses, severities and event types.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "health"
    },
    {
      "name": "auth"
    },
    {
      "name": "users"
    },
    {
      "name": "stores"
    },
    {
      "name": "cameras"
    },
    {
      "name": "alerts"
    },
    {
      "name": "notifications"
    },
    {
      "name": "live",
      "description": "Live camera view through MediaMTX HLS (LIVE_VIEW_MODE)."
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Create the first owner and store",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created"
          },
          "409": {
            "description": "Email or store code exists"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Log in",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Rotate refresh session",
        "responses": {
          "201": {
            "description": "Session refreshed"
          },
          "401": {
            "description": "Invalid refresh cookie"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Revoke refresh session",
        "responses": {
          "201": {
            "description": "Logged out"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Current user and stores",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/users/me": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Get owner profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profile"
          }
        }
      },
      "patch": {
        "tags": [
          "users"
        ],
        "summary": "Update owner profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "displayName"
                ],
                "properties": {
                  "displayName": {
                    "type": "string",
                    "example": "Store Owner"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          }
        }
      }
    },
    "/api/v1/stores": {
      "get": {
        "tags": [
          "stores"
        ],
        "summary": "List accessible stores",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Stores"
          }
        },
        "description": "Stores the caller belongs to. Stores are created by the AI service from its manifest; there is no create route."
      }
    },
    "/api/v1/stores/{storeId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        }
      ],
      "get": {
        "tags": [
          "stores"
        ],
        "summary": "Get store",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Store"
          }
        }
      }
    },
    "/api/v1/stores/{storeId}/members": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        }
      ],
      "get": {
        "tags": [
          "stores"
        ],
        "summary": "List store members",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Members"
          }
        }
      },
      "post": {
        "tags": [
          "stores"
        ],
        "summary": "Add existing user to store",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "role"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "manager",
                      "operator"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Added"
          }
        }
      }
    },
    "/api/v1/stores/{storeId}/members/{memberId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        },
        {
          "name": "memberId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "patch": {
        "tags": [
          "stores"
        ],
        "summary": "Update member role",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "role"
                ],
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "manager",
                      "operator"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          }
        }
      },
      "delete": {
        "tags": [
          "stores"
        ],
        "summary": "Remove member",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Removed"
          }
        }
      }
    },
    "/api/v1/stores/{storeId}/cameras": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        }
      ],
      "get": {
        "tags": [
          "cameras"
        ],
        "summary": "List cameras",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Cameras"
          }
        },
        "description": "Read-only: the AI service upserts cameras from its manifest at startup. Each camera lists the AI pipelines bound to it. The stream address is never returned."
      }
    },
    "/api/v1/stores/{storeId}/cameras/{cameraId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        },
        {
          "$ref": "#/components/parameters/CameraId"
        }
      ],
      "get": {
        "tags": [
          "cameras"
        ],
        "summary": "Get camera",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Camera"
          }
        }
      }
    },
    "/api/v1/stores/{storeId}/cameras/{cameraId}/zones": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        },
        {
          "$ref": "#/components/parameters/CameraId"
        }
      ],
      "get": {
        "tags": [
          "cameras"
        ],
        "summary": "Zones the camera's AI pipelines use (display only)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Zones"
          }
        },
        "description": "From cameras.metadata_json, written by the AI service from its zone files. pointsNorm are fractions of frame width/height."
      }
    },
    "/api/v1/stores/{storeId}/alerts": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        }
      ],
      "get": {
        "tags": [
          "alerts"
        ],
        "summary": "List and filter alerts",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "open",
                "acknowledged",
                "confirmed",
                "dismissed"
              ]
            }
          },
          {
            "name": "severity",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "warning",
                "high",
                "critical"
              ]
            }
          },
          {
            "name": "eventType",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "suspected_cash_concealment",
                "unknown_entry",
                "staff_outside_schedule",
                "watchlist_match",
                "weapon_detected"
              ]
            }
          },
          {
            "name": "pipelineType",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cameraId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "nextCursor from the previous page"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 30,
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Alert page"
          }
        },
        "description": "Newest first by opened_at. Page with nextCursor (opaque)."
      }
    },
    "/api/v1/stores/{storeId}/alerts/{alertId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        },
        {
          "$ref": "#/components/parameters/AlertId"
        }
      ],
      "get": {
        "tags": [
          "alerts"
        ],
        "summary": "Get alert detail and evidence",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Alert detail"
          }
        }
      }
    },
    "/api/v1/stores/{storeId}/alerts/{alertId}/acknowledge": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        },
        {
          "$ref": "#/components/parameters/AlertId"
        }
      ],
      "post": {
        "tags": [
          "alerts"
        ],
        "summary": "Acknowledge alert",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/AlertAction"
        },
        "responses": {
          "201": {
            "description": "Acknowledged"
          },
          "403": {
            "description": "Insufficient role to make or correct this decision."
          },
          "409": {
            "description": "Transition is invalid or the same decision has already been applied."
          }
        },
        "description": "Decisions are serialized and recorded with immutable before/after audit snapshots. open -> acknowledged | confirmed | dismissed. confirmed requires manager or owner; operators cannot change confirmed or dismissed decisions. Repeating a decision returns 409."
      }
    },
    "/api/v1/stores/{storeId}/alerts/{alertId}/dismiss": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        },
        {
          "$ref": "#/components/parameters/AlertId"
        }
      ],
      "post": {
        "tags": [
          "alerts"
        ],
        "summary": "Dismiss alert",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/AlertAction"
        },
        "responses": {
          "201": {
            "description": "Dismissed"
          },
          "403": {
            "description": "Insufficient role to make or correct this decision."
          },
          "409": {
            "description": "Transition is invalid or the same decision has already been applied."
          }
        },
        "description": "Decisions are serialized and recorded with immutable before/after audit snapshots. open -> acknowledged | confirmed | dismissed. confirmed requires manager or owner; operators cannot change confirmed or dismissed decisions. Repeating a decision returns 409."
      }
    },
    "/api/v1/notification-review/{token}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ReviewToken"
        }
      ],
      "get": {
        "tags": [
          "alerts"
        ],
        "summary": "Stream evidence through an expiring opaque review token",
        "description": "Public bearer-token endpoint used by notification links. Supports HTTP Range and never redirects to or reveals the evidence origin/storage key.",
        "security": [],
        "responses": {
          "200": {
            "description": "Evidence stream"
          },
          "206": {
            "description": "Partial evidence stream"
          },
          "404": {
            "description": "Invalid, expired or revoked token"
          },
          "502": {
            "description": "Evidence origin unavailable"
          }
        }
      }
    },
    "/api/v1/webhooks/whatsapp": {
      "get": {
        "tags": [
          "notifications"
        ],
        "summary": "Verify the Meta WhatsApp webhook",
        "description": "Public Meta verification handshake. The configured verify token is compared server-side and is never returned.",
        "security": [],
        "parameters": [
          {
            "name": "hub.mode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "subscribe"
              ]
            }
          },
          {
            "name": "hub.verify_token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hub.challenge",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Challenge echoed as plain text"
          },
          "403": {
            "description": "Verification failed"
          },
          "503": {
            "description": "Webhook not configured"
          }
        }
      },
      "post": {
        "tags": [
          "notifications"
        ],
        "summary": "Receive signed WhatsApp delivery receipts",
        "description": "Validates X-Hub-Signature-256 over the raw body, accepts at most 1 MiB, and idempotently records only stable sent/delivered/read/failed status data. Raw webhook bodies and recipient data are not persisted.",
        "security": [],
        "responses": {
          "200": {
            "description": "Signed webhook accepted"
          },
          "400": {
            "description": "Malformed webhook payload"
          },
          "401": {
            "description": "Invalid signature"
          },
          "413": {
            "description": "Body too large"
          },
          "503": {
            "description": "Webhook not configured"
          }
        }
      }
    },
    "/api/v1/stores/{storeId}/notification-endpoints": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        }
      ],
      "get": {
        "tags": [
          "notifications"
        ],
        "summary": "List notification endpoints (OWNER only)",
        "description": "Responses never contain credentialRef (only credentialConfigured) and destinations are masked. Lists return [].",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Endpoints"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Requires store OWNER"
          }
        }
      },
      "post": {
        "tags": [
          "notifications"
        ],
        "summary": "Create notification endpoint (OWNER only)",
        "description": "Provider is immutable afterwards. Duplicate (store, provider, destinationRef) returns 409. Raw credentials in credentialRef or config are rejected with 400. Enabling WHATSAPP additionally requires providerAccountRef (Meta Phone Number ID), an E.164 destinationRef and wabaId/templateName/templateLanguage/templateVersion/optIn evidence in config (400 otherwise).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationEndpointCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid payload, raw credential or WhatsApp enable validation"
          },
          "409": {
            "description": "Duplicate destination"
          },
          "403": {
            "description": "OWNER permission and an exact server-managed credential binding for this store/provider/account are required."
          }
        }
      }
    },
    "/api/v1/stores/{storeId}/notification-endpoints/{endpointId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        },
        {
          "$ref": "#/components/parameters/EndpointId"
        }
      ],
      "patch": {
        "tags": [
          "notifications"
        ],
        "summary": "Update notification endpoint (OWNER only)",
        "description": "Partial update; empty bodies and immutable fields such as provider are rejected with 400. Changing destinationRef to a duplicate returns 409. DELETE is blocked with 409 when delivery history exists - disable via isEnabled=false instead.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationEndpointUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "400": {
            "description": "Invalid payload, unknown field, empty body or WhatsApp enable validation"
          },
          "404": {
            "description": "Endpoint outside caller's store"
          },
          "409": {
            "description": "Duplicate destination or delivery history"
          },
          "403": {
            "description": "OWNER permission and an exact server-managed credential binding for this store/provider/account are required."
          }
        }
      },
      "delete": {
        "tags": [
          "notifications"
        ],
        "summary": "Delete endpoint without delivery history (OWNER only)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "404": {
            "description": "Endpoint outside caller's store"
          },
          "409": {
            "description": "Delivery history exists; soft-disable instead"
          }
        }
      }
    },
    "/api/v1/stores/{storeId}/notification-endpoints/{endpointId}/test": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        },
        {
          "$ref": "#/components/parameters/EndpointId"
        }
      ],
      "post": {
        "tags": [
          "notifications"
        ],
        "summary": "Enqueue a TEST-kind delivery (OWNER only)",
        "description": "Idempotent for the same requestId. New TEST deliveries have atomic per-endpoint/store/requester and global quotas and pending limits. ALERT jobs have priority in the worker.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationTestRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Test delivery enqueued"
          },
          "400": {
            "description": "Missing or invalid requestId"
          },
          "404": {
            "description": "Endpoint outside caller's store"
          },
          "409": {
            "description": "Endpoint disabled"
          },
          "403": {
            "description": "OWNER permission and an exact server-managed credential binding for this store/provider/account are required."
          },
          "429": {
            "description": "Test quota or pending-job limit exceeded. Retry-After is provided."
          }
        }
      }
    },
    "/api/v1/stores/{storeId}/notification-rules": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        }
      ],
      "get": {
        "tags": [
          "notifications"
        ],
        "summary": "List notification rules (OWNER only)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Rules"
          }
        }
      },
      "post": {
        "tags": [
          "notifications"
        ],
        "summary": "Create notification rule (OWNER only)",
        "description": "name is required. Omitted fields default: minimumSeverity=critical, alertTypes=[], cooldownSeconds=0, isEnabled=true. minimumSeverity and alertTypes combine with AND; empty alertTypes matches every alert type passing severity. Nonzero cooldownSeconds is evaluated transactionally against the exact incident fingerprint; emergency rules should remain 0.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationRuleCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid payload"
          }
        }
      }
    },
    "/api/v1/stores/{storeId}/notification-rules/{ruleId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        },
        {
          "$ref": "#/components/parameters/RuleId"
        }
      ],
      "patch": {
        "tags": [
          "notifications"
        ],
        "summary": "Update notification rule (OWNER only)",
        "description": "Partial update; omitted fields keep their current values and create defaults are not reapplied. Empty bodies are rejected.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationRuleUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "400": {
            "description": "Invalid payload, unknown field or empty body"
          },
          "404": {
            "description": "Rule outside caller's store"
          }
        }
      },
      "delete": {
        "tags": [
          "notifications"
        ],
        "summary": "Delete rule without delivery history (OWNER only)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "404": {
            "description": "Rule outside caller's store"
          },
          "409": {
            "description": "Delivery history exists; soft-disable instead"
          }
        }
      }
    },
    "/api/v1/stores/{storeId}/notification-rules/{ruleId}/channels": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        },
        {
          "$ref": "#/components/parameters/RuleId"
        }
      ],
      "get": {
        "tags": [
          "notifications"
        ],
        "summary": "List rule channels ordered by priority (OWNER only)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Channels"
          }
        }
      },
      "post": {
        "tags": [
          "notifications"
        ],
        "summary": "Add a channel route to a rule (OWNER only)",
        "description": "Endpoint must belong to the same store. Lower priority routes first. Duplicate rule+endpoint or duplicate priority returns 409. Task 3 configures routing only; fallback activation after failures belongs to Task 5.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationRuleChannelCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid payload"
          },
          "404": {
            "description": "Rule or endpoint outside caller's store"
          },
          "409": {
            "description": "Duplicate endpoint or priority in rule"
          }
        }
      }
    },
    "/api/v1/stores/{storeId}/notification-rules/{ruleId}/channels/{channelId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        },
        {
          "$ref": "#/components/parameters/RuleId"
        },
        {
          "$ref": "#/components/parameters/ChannelId"
        }
      ],
      "patch": {
        "tags": [
          "notifications"
        ],
        "summary": "Update channel priority, delay or enabled flag (OWNER only)",
        "description": "Partial update; endpointId is immutable and unknown fields are rejected with 400. Duplicate priority returns 409.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationRuleChannelUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "400": {
            "description": "Invalid payload, unknown field or empty body"
          },
          "404": {
            "description": "Channel outside caller's store/rule"
          },
          "409": {
            "description": "Duplicate priority in rule or delivery history"
          }
        }
      },
      "delete": {
        "tags": [
          "notifications"
        ],
        "summary": "Delete channel without delivery history (OWNER only)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "404": {
            "description": "Channel outside caller's store/rule"
          },
          "409": {
            "description": "Delivery history exists; soft-disable instead"
          }
        }
      }
    },
    "/api/v1/stores/{storeId}/notification-deliveries": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        }
      ],
      "get": {
        "tags": [
          "notifications"
        ],
        "summary": "List notification delivery history (OWNER only)",
        "description": "Filters by status/provider/kind/alertId. Responses omit payload, credentialRef and raw destination.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "WAITING_FALLBACK",
                "PENDING",
                "PROCESSING",
                "RETRY_SCHEDULED",
                "SENT",
                "FAILED",
                "CANCELLED"
              ]
            }
          },
          {
            "name": "provider",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "TELEGRAM",
                "WHATSAPP"
              ]
            }
          },
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ALERT",
                "TEST"
              ]
            }
          },
          {
            "name": "alertId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Delivery page"
          },
          "403": {
            "description": "Requires store OWNER"
          }
        }
      }
    },
    "/api/v1/stores/{storeId}/notification-deliveries/{deliveryId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        },
        {
          "$ref": "#/components/parameters/DeliveryId"
        }
      ],
      "get": {
        "tags": [
          "notifications"
        ],
        "summary": "Get delivery, attempt log and provider receipts (OWNER only)",
        "description": "Includes sanitized WhatsApp sent/delivered/read/failed receipt events. Does not expose durable payloads, storage keys, credentials, raw destinations or webhook bodies.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Delivery, attempts and provider events"
          },
          "404": {
            "description": "Delivery outside caller's store"
          }
        }
      }
    },
    "/api/v1/stores/{storeId}/alerts/{alertId}/confirm": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        },
        {
          "$ref": "#/components/parameters/AlertId"
        }
      ],
      "post": {
        "tags": [
          "alerts"
        ],
        "summary": "Confirm alert as a real incident",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/AlertAction"
        },
        "description": "Decisions are serialized and recorded with immutable before/after audit snapshots. open -> acknowledged | confirmed | dismissed. confirmed requires manager or owner; operators cannot change confirmed or dismissed decisions. Repeating a decision returns 409.",
        "responses": {
          "201": {
            "description": "Confirmed"
          },
          "403": {
            "description": "Insufficient role to make or correct this decision."
          },
          "409": {
            "description": "Transition is invalid or the same decision has already been applied."
          }
        }
      }
    },
    "/api/v1/stores/{storeId}/alerts/{alertId}/media/{mediaId}/playback-url": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        },
        {
          "$ref": "#/components/parameters/AlertId"
        },
        {
          "$ref": "#/components/parameters/MediaId"
        }
      ],
      "get": {
        "tags": [
          "alerts"
        ],
        "summary": "Create a short-lived playback URL for one clip or snapshot",
        "description": "operator or higher. The URL points at /notification-review/{token}, which fetches the object from R2 with a presigned request; it never exposes the bucket or key.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Short-lived playback URL"
          },
          "404": {
            "description": "Media outside alert/store scope"
          },
          "503": {
            "description": "PUBLIC_API_BASE_URL or R2_* not configured"
          }
        }
      }
    },
    "/api/v1/stores/{storeId}/live-session": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StoreId"
        }
      ],
      "post": {
        "tags": [
          "live"
        ],
        "summary": "Start a live-view session for this store",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "operator or higher. Sets the HttpOnly cookie liquor_live (Path=/live/, 30 min) and returns each active camera's HLS path. The browser then plays /live/<camera_id>/index.m3u8 through the reverse proxy.",
        "responses": {
          "201": {
            "description": "mode (test | production), expiresInSeconds, streams {camera_id: path}"
          },
          "404": {
            "description": "Store not found for this user"
          },
          "503": {
            "description": "LIVE_VIEW_MODE is not set"
          }
        }
      }
    },
    "/api/v1/live/authorize": {
      "get": {
        "tags": [
          "live"
        ],
        "summary": "Reverse-proxy check for one /live/ request (forward_auth)",
        "description": "Reads X-Forwarded-Uri (/live/<camera_id>/...) and the liquor_live cookie. 204 when the cookie's owner may view that camera of its store.",
        "responses": {
          "204": {
            "description": "Allowed"
          },
          "401": {
            "description": "No or invalid live cookie"
          },
          "403": {
            "description": "Not this owner's camera, or not a camera path"
          },
          "503": {
            "description": "Live view disabled"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "StoreId": {
        "name": "storeId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,200}$"
        },
        "description": "The AI manifest's store_id, e.g. store_test_01."
      },
      "CameraId": {
        "name": "cameraId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "The AI manifest's camera_id, e.g. st01_counter."
      },
      "AlertId": {
        "name": "alertId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "alerts.alert_id (a UUID string written by the AI service)."
      },
      "EndpointId": {
        "name": "endpointId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "RuleId": {
        "name": "ruleId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ChannelId": {
        "name": "channelId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "DeliveryId": {
        "name": "deliveryId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ReviewToken": {
        "name": "token",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 40,
          "maxLength": 64
        }
      },
      "MediaId": {
        "name": "mediaId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "alert_media.media_id: one clip or snapshot of the alert."
      }
    },
    "requestBodies": {
      "AlertAction": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "note": {
                  "type": "string",
                  "maxLength": 1000,
                  "example": "Reviewed by owner"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "owner@demo.com"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "email",
          "password",
          "displayName",
          "storeId"
        ],
        "description": "Only when REGISTER_ENABLED. Links a new owner to a store the AI service already created.",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 12,
            "maxLength": 128
          },
          "displayName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "storeId": {
            "type": "string"
          }
        }
      },
      "NotificationEndpointCreateRequest": {
        "type": "object",
        "required": [
          "provider",
          "label",
          "destinationRef",
          "credentialRef"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "TELEGRAM",
              "WHATSAPP"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "providerAccountRef": {
            "type": "string",
            "description": "Bot username or Meta Phone Number ID identifier, never a token"
          },
          "destinationRef": {
            "type": "string",
            "description": "Telegram chat_id, or E.164 phone number for WHATSAPP; masked in responses"
          },
          "credentialRef": {
            "type": "string",
            "description": "Reference pre-assigned by server NOTIFICATION_CREDENTIAL_BINDINGS to this store/provider/account; only provider-specific env:// references are supported. Client-selected arbitrary environment variables are denied."
          },
          "config": {
            "type": "object",
            "additionalProperties": true,
            "description": "Non-secret options only; token/secret/password/credential keys and token-like values are rejected"
          },
          "isEnabled": {
            "type": "boolean",
            "default": true,
            "description": "Enabling WHATSAPP requires providerAccountRef, an E.164 destinationRef and wabaId/templateName/templateLanguage/templateVersion/optIn evidence in config"
          }
        }
      },
      "NotificationEndpointUpdateRequest": {
        "type": "object",
        "description": "Partial update; provider is immutable and unknown or empty bodies are rejected with 400.",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "providerAccountRef": {
            "type": "string"
          },
          "destinationRef": {
            "type": "string"
          },
          "credentialRef": {
            "type": "string",
            "description": "Reference pre-assigned by server NOTIFICATION_CREDENTIAL_BINDINGS to this store/provider/account; only provider-specific env:// references are supported. Client-selected arbitrary environment variables are denied."
          },
          "config": {
            "type": "object",
            "additionalProperties": true
          },
          "isEnabled": {
            "type": "boolean"
          }
        }
      },
      "NotificationRuleCreateRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minimumSeverity": {
            "type": "string",
            "enum": [
              "warning",
              "high",
              "critical"
            ],
            "default": "critical"
          },
          "alertTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "suspected_cash_concealment",
                "unknown_entry",
                "staff_outside_schedule",
                "watchlist_match",
                "weapon_detected"
              ]
            },
            "default": [],
            "description": "Empty array matches every alert type that passes severity; duplicates are normalized"
          },
          "cooldownSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400,
            "default": 0,
            "description": "Optional incident-fingerprint cooldown for non-emergency rules; emergency rules should remain 0"
          },
          "isEnabled": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "NotificationRuleUpdateRequest": {
        "type": "object",
        "description": "Partial update; omitted fields keep their current values.",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minimumSeverity": {
            "type": "string",
            "enum": [
              "warning",
              "high",
              "critical"
            ]
          },
          "alertTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "suspected_cash_concealment",
                "unknown_entry",
                "staff_outside_schedule",
                "watchlist_match",
                "weapon_detected"
              ]
            }
          },
          "cooldownSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          },
          "isEnabled": {
            "type": "boolean"
          }
        }
      },
      "NotificationRuleChannelCreateRequest": {
        "type": "object",
        "required": [
          "endpointId"
        ],
        "properties": {
          "endpointId": {
            "type": "string",
            "format": "uuid",
            "description": "Immutable after creation; must belong to the same store"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999,
            "default": 1,
            "description": "Lower values route first; unique within a rule"
          },
          "fallbackDelaySeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400,
            "default": 0
          },
          "isEnabled": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "NotificationRuleChannelUpdateRequest": {
        "type": "object",
        "description": "Partial update; endpointId is immutable.",
        "properties": {
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "fallbackDelaySeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          },
          "isEnabled": {
            "type": "boolean"
          }
        }
      },
      "NotificationTestRequest": {
        "type": "object",
        "required": [
          "requestId"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid",
            "description": "Client-generated UUID making repeated test requests idempotent"
          }
        }
      }
    }
  }
}
